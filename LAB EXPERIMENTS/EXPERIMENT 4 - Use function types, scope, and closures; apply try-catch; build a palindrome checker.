<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>plalindrome Checker</title>
    <style>
        body {
            font-family: monospace;
            background-color: pink;
            color: black;
            padding: 50px;
        }

        h1 {
            font-size: 20px;
            text-transform: uppercase;
        }
        h2 {
            font-size: 60px;
            font-style: italic;
            color: black;
        }

        .box {
            background-color: black;
            color: white;
            padding: 20px;
            width: 600px;
            border: 4px solid black; 
        }

        input {
            width: 90%;
            padding: 8px;
            margin-bottom: 10px;
            background-color: white;
            color: black;
            border: 2px solid pink;
        }

        button {
            width: 97%;
            padding: 10px;
            background-color: pink;
            color: black;
            font-weight: bold;
            border: 2px solid white;
            cursor: pointer;
        }

        .result-box {
            margin-top: 15px;
            padding: 10px;
            border: 2px dashed pink;
            display: none;
        }
    </style>
</head>
<body>

    <div class="box">
        <h1>Checker</h1>
        <p>Is it a palindrome?</p>
        
        <input type="text" id="wordInput" placeholder="Type here...">
        <button id="submitBtn">CHECK</button>

        <div id="outputDisplay" class="result-box"></div>
        <p id="totalChecks">Checks: 0</p>
    </div>
    <h2> 24070521213</h2>
    <script>
        const submitBtn = document.getElementById('submitBtn');
        const wordInput = document.getElementById('wordInput');
        const outputDisplay = document.getElementById('outputDisplay');
        const totalChecks = document.getElementById('totalChecks');

        function makeCounter() {
            let count = 0; 
            return function() {
                count++; 
                return count;
            };
        }
        const incrementChecks = makeCounter();

        function basicClean(str) {
            return str.toLowerCase().replace(/[^a-z0-9]/g, '');
        }

        const flipString = function(str) {
            return str.split('').reverse().join('');
        };

        const checkMatch = (a, b) => a === b;

        submitBtn.addEventListener('click', function() {
            outputDisplay.style.display = "none";

            try {
                const textValue = wordInput.value;

                if (textValue.trim() === "") {
                    throw new Error("Type a word first!");
                }

                const clean = basicClean(textValue);
                const reversed = flipString(clean);
                const isTrue = checkMatch(clean, reversed);

                const currentCount = incrementChecks();
                totalChecks.textContent = "Checks: " + currentCount;

                outputDisplay.style.display = "block";
                if (isTrue) {
                    outputDisplay.textContent = "Yes! Matches backward.";
                } else {
                    outputDisplay.textContent = "No! Does not match.";
                }

            } catch (err) {
                outputDisplay.style.display = "block";
                outputDisplay.textContent = "Error: " + err.message;
            }
        });
    </script>
</body>
</html>
